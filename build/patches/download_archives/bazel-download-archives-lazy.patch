diff --git a/lib/download.bzl b/lib/download.bzl
index 3082296..48f0a39 100644
--- a/lib/download.bzl
+++ b/lib/download.bzl
@@ -1,5 +1,14 @@
 """Shared download helpers for archive repository rules."""
 
+load("//lib:utils.bzl", Utils = "utils")
+
+_SOURCE_BZL = '''\
+"""Generated by download_archives. DO NOT EDIT."""
+
+SOURCE = "{source}"
+URL = "{url}"
+'''
+
 _BUILD_PATCHES = '''\
 """Generated by download_archives. DO NOT EDIT."""
 
@@ -101,8 +110,95 @@ def _apply_patch(rctx, version, source, patch):
 
     rctx.patch(patch_file, strip = 1)
 
+def _try_sources(
+        rctx,
+        repo_name,
+        version,
+        repos,
+        patches = {},
+        spec_syntax = "",
+        version_scheme = "",
+        strict_integrity = False,
+        _print = print,
+        _fail = fail):
+    """Try downloading a version from each source in order.
+
+    Handles the full download-level workflow: strict integrity check, download,
+    integrity warning, source.bzl generation, and patch application. Archives
+    are extracted to `version/source/` and patches are rewritten to match the
+    nested layout.
+
+    Args:
+        rctx: Repository context.
+        repo_name: Name for log/error messages.
+        version: Version being downloaded.
+        repos: List of repo struct sources to try, in order.
+        patches: label_keyed_string_dict of patch labels to version specs.
+            Matching is computed per-source; only the winning source's patches
+            are applied.
+        spec_syntax: Spec syntax for patch matching.
+        version_scheme: Version scheme for patch matching.
+        strict_integrity: If True, fail when sources have different integrity
+            hashes.
+        _print: Print function for warnings.
+        _fail: Fail function for errors.
+
+    Returns:
+        struct(source, url, integrity, sha256, output, patches) on first
+        success, or None if all sources failed.
+    """
+    if strict_integrity:
+        _check_strict_integrity(repos, version, _fail)
+
+    for repo in repos:
+        repo_path = "%s/%s" % (version, repo.source)
+        download_args = _make_download_args(repo_path, repo.context, _print)
+
+        result = rctx.download_and_extract(
+            output = repo_path,
+            allow_fail = True,
+            **download_args
+        )
+
+        if not result.success:
+            continue
+
+        if "integrity" not in repo.context:
+            msg = "{}/{}: WARNING: integrity missing. "
+            msg += "Please add the integrity / sha256 to the index: {} / {}"
+            _print(msg.format(repo_name, repo_path, result.integrity, result.sha256))
+
+        rctx.file(
+            "%s/source.bzl" % version,
+            _SOURCE_BZL.format(source = repo.source, url = repo.context["url"]),
+            executable = False,
+        )
+
+        matched_patches = Utils.matching_patches(
+            patches,
+            version,
+            repo.source,
+            spec_syntax,
+            version_scheme,
+        )
+
+        for patch in matched_patches:
+            _apply_patch(rctx, version, repo.source, patch)
+
+        return struct(
+            source = repo.source,
+            url = repo.context["url"],
+            integrity = result.integrity,
+            sha256 = result.sha256,
+            output = repo_path,
+            patches = matched_patches,
+        )
+
+    return None
+
 download = struct(
     check_strict_integrity = _check_strict_integrity,
     make_download_args = _make_download_args,
     apply_patch = _apply_patch,
+    try_sources = _try_sources,
 )
