"""
Unit tests for monoext/private/pkgs/hub.bzl render helpers.

Each helper is a pure function that emits one BUILD.bazel file text. Tests call
the helper with mock data and assert on structural substrings (header,
visibility, alias names, targets); resilient to cosmetic formatting changes.
"""

load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")

# buildifier: disable=bzl-visibility
load("//monoext/private/pkgs:hub.bzl", _PkgsHub = "testing")
load("//tests:suite.bzl", _test_suite = "test_suite")

# --- root_build ------------------------------------------------------------

def _root_build_test_impl(ctx):
    """Root BUILD contains the generator header and public default visibility."""
    env = unittest.begin(ctx)

    out = _PkgsHub._root_build()

    asserts.true(env, "Generated by monoext/private/pkgs. DO NOT EDIT." in out)
    asserts.true(env, "default_visibility" in out)
    asserts.true(env, '"//visibility:public"' in out)

    return unittest.end(env)

root_build_test = unittest.make(_root_build_test_impl)

# --- deb_pkg_build ---------------------------------------------------------

def _deb_pkg_build_cross_arch_and_versions_test_impl(ctx):
    """deb/{pkg}/BUILD.bazel: cross-arch alias + one version alias per unique version."""
    env = unittest.begin(ctx)

    arch_versions = {
        "amd64": "3.0.15-1~deb12u1",
        "arm64": "3.0.15-1~deb12u1",  # same version across archs
    }
    out = _PkgsHub._deb_pkg_build(
        pkg = "libssl-dev",
        deb_repo = "pg_pkgs_deb",
        arch_versions = arch_versions.values(),
    )

    # cross-arch alias
    asserts.true(env, 'name = "libssl-dev"' in out)
    asserts.true(
        env,
        'actual = "@pg_pkgs_deb//libssl-dev:libssl-dev"' in out,
    )

    # version alias (with Debian ':' sanitized to '_', no colon here)
    asserts.true(env, 'name = "3.0.15-1~deb12u1"' in out)

    return unittest.end(env)

deb_pkg_build_cross_arch_and_versions_test = unittest.make(
    _deb_pkg_build_cross_arch_and_versions_test_impl,
)

def _deb_pkg_build_sanitizes_epoch_colon_test_impl(ctx):
    """Debian versions with epoch (`1:14.0.6-12`) → `:` is replaced with `_`."""
    env = unittest.begin(ctx)

    out = _PkgsHub._deb_pkg_build(
        pkg = "libpq5",
        deb_repo = "pg_pkgs_deb",
        arch_versions = ["1:14.0.6-12"],
    )

    asserts.true(env, 'name = "1_14.0.6-12"' in out)

    # not present in raw form
    asserts.false(env, 'name = "1:14.0.6-12"' in out)

    return unittest.end(env)

deb_pkg_build_sanitizes_epoch_colon_test = unittest.make(
    _deb_pkg_build_sanitizes_epoch_colon_test_impl,
)

# --- deb_pkg_arch_build ----------------------------------------------------

def _deb_pkg_arch_build_aliases_test_impl(ctx):
    """deb/{pkg}/{arch}/BUILD.bazel: arch alias + version alias to arch."""
    env = unittest.begin(ctx)

    out = _PkgsHub._deb_pkg_arch_build(
        pkg = "libssl-dev",
        arch = "amd64",
        version = "3.0.15-1~deb12u1",
        deb_repo = "pg_pkgs_deb",
    )

    # per-arch alias
    asserts.true(env, 'name = "amd64"' in out)
    asserts.true(
        env,
        'actual = "@pg_pkgs_deb//libssl-dev/amd64:amd64"' in out,
    )

    # version alias → :arch
    asserts.true(env, 'name = "3.0.15-1~deb12u1"' in out)
    asserts.true(env, 'actual = ":amd64"' in out)

    return unittest.end(env)

deb_pkg_arch_build_aliases_test = unittest.make(
    _deb_pkg_arch_build_aliases_test_impl,
)

def _deb_pkg_arch_build_sanitizes_epoch_test_impl(ctx):
    """Per-arch version alias also sanitizes `:`."""
    env = unittest.begin(ctx)

    out = _PkgsHub._deb_pkg_arch_build(
        pkg = "libpq5",
        arch = "amd64",
        version = "1:14.0.6-12",
        deb_repo = "pg_pkgs_deb",
    )

    asserts.true(env, 'name = "1_14.0.6-12"' in out)
    asserts.false(env, 'name = "1:14.0.6-12"' in out)

    return unittest.end(env)

deb_pkg_arch_build_sanitizes_epoch_test = unittest.make(
    _deb_pkg_arch_build_sanitizes_epoch_test_impl,
)

# --- sysroots_build --------------------------------------------------------

def _sysroots_build_emits_one_flatten_per_group_test_impl(ctx):
    """deb/sysroots/BUILD.bazel: one flatten() per sysroot group, loads flatten."""
    env = unittest.begin(ctx)

    groups = {
        "sysroot-abc": [
            "@pg_pkgs//deb/libssl-dev:libssl-dev",
            "@pg_pkgs//deb/libc6-dev:libc6-dev",
        ],
        "sysroot-xyz": [
            "@pg_pkgs//deb/libzstd-dev:libzstd-dev",
        ],
    }
    out = _PkgsHub._sysroots_build(groups)

    # load for flatten rule
    asserts.true(
        env,
        '"@rules_distroless//distroless:defs.bzl"' in out,
    )
    asserts.true(env, '"flatten"' in out)

    # each group emits a named flatten
    asserts.true(env, 'name = "sysroot-abc"' in out)
    asserts.true(env, 'name = "sysroot-xyz"' in out)

    # tars listed via Star.ref; no quotes around the label list expression, but
    # the labels themselves do appear in the rendered expression
    asserts.true(env, "libssl-dev" in out)
    asserts.true(env, "libzstd-dev" in out)

    # deduplicate=True on every flatten
    asserts.true(env, "deduplicate = True" in out)

    return unittest.end(env)

sysroots_build_emits_one_flatten_per_group_test = unittest.make(
    _sysroots_build_emits_one_flatten_per_group_test_impl,
)

def _sysroots_build_empty_groups_test_impl(ctx):
    """No groups → still a valid BUILD (header + load + package + no flatten calls)."""
    env = unittest.begin(ctx)

    out = _PkgsHub._sysroots_build({})

    asserts.true(env, "Generated by monoext/private/pkgs. DO NOT EDIT." in out)
    asserts.true(
        env,
        '"@rules_distroless//distroless:defs.bzl"' in out,
    )
    asserts.false(env, "flatten(" in out)

    return unittest.end(env)

sysroots_build_empty_groups_test = unittest.make(
    _sysroots_build_empty_groups_test_impl,
)

TEST_SUITE_NAME = "hub"

TEST_SUITE_TESTS = dict(
    deb_pkg_arch_build_aliases = deb_pkg_arch_build_aliases_test,
    deb_pkg_arch_build_sanitizes_epoch = deb_pkg_arch_build_sanitizes_epoch_test,
    deb_pkg_build_cross_arch_and_versions = deb_pkg_build_cross_arch_and_versions_test,
    deb_pkg_build_sanitizes_epoch_colon = deb_pkg_build_sanitizes_epoch_colon_test,
    root_build = root_build_test,
    sysroots_build_empty_groups = sysroots_build_empty_groups_test,
    sysroots_build_emits_one_flatten_per_group = sysroots_build_emits_one_flatten_per_group_test,
)

test_suite = lambda: _test_suite(TEST_SUITE_NAME, TEST_SUITE_TESTS)
