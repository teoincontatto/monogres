"""The `deps/<kind>` packages an extension's targets resolve their Debian deps through.

One directory per (extension, version, kind), holding the two aliases a
consumer asks for -- `:sysroot` and `:sysroot_tar`, arch-selected into the
shared `@pgbuildtime_<key>` hub the package group resolved to -- and one alias
per resolved package under `pkgs/`, which is what an image layer stages.

Rendered for external extensions (`<ext>/<ext_v>/deps/...`) and for the entries
carved out of the base flavor's own tree (`contrib/<name>/<base_v>/deps/...`).
The second used to render nothing, on the grounds that a contrib inherits
PostgreSQL's deps; that stopped being true when contrib became a layer composed
onto a base image which no longer carries it.
"""

load("@starlark_utils//starlark:starlark.bzl", Star = "starlark")
load("//monoext/private/pkgs:schema.bzl", _PkgsSchema = "schema")
load("//platforms:targets.bzl", "ARCH_CPU")

_HEADER = "Generated by monoext/private/ext. DO NOT EDIT."

def sysroot_select(labels_by_arch):
    """Build a `Star.select` node keyed by `@platforms//cpu:*` constraints.

    Args:
        labels_by_arch: `{arch_name: label_str}` from
            `DepsInfo.sysroot_labels_by_arch`.

    Returns:
        A `Star.select` node for use as an `alias(actual = ...)` value.
    """
    return Star.select({
        "@platforms//cpu:%s" % ARCH_CPU[arch]: label
        for arch, label in labels_by_arch.items()
    })

def deps_kind_build(alias_pairs):
    """Render a `deps/{kind}` BUILD.bazel: package + N aliases."""
    return Star.file(
        Star.package(default_visibility = ["//visibility:public"]),
        header = _HEADER,
        *[Star.alias(name, actual) for name, actual in alias_pairs]
    )

def write_deps_package(rctx, package_dir, version_deps):
    """Writes the `<package_dir>/deps/` hierarchy, one directory per kind.

    Args:
        rctx: Repository context.
        package_dir: Repo-relative directory the `deps/` tree hangs off --
            `<ext>/<ext_v>` for an external extension, `contrib/<name>/<base_v>`
            for one carved out of the base. It is the same string the target's
            labels were qualified with (`TargetDeps.qualify`), so the two cannot
            name different places.
        version_deps: `VersionDeps` for that version. A kind with no packages
            renders nothing, which is why an extension needing nothing from the
            distro has no `deps/` directory at all.
    """
    for kind in _PkgsSchema.KINDS:
        deps_info = getattr(version_deps, kind)
        if not deps_info:
            continue

        alias_pairs = [
            ("sysroot", sysroot_select(deps_info.sysroot_labels_by_arch)),
            ("sysroot_tar", sysroot_select(
                deps_info.sysroot_tar_labels_by_arch,
            )),
        ]
        rctx.file(
            "%s/deps/%s/BUILD.bazel" % (package_dir, kind),
            deps_kind_build(alias_pairs),
        )

        if deps_info.packages:
            rctx.file(
                "%s/deps/%s/pkgs/BUILD.bazel" % (package_dir, kind),
                deps_kind_build([
                    (pkg, deps_info.pkgs_labels[i])
                    for i, pkg in enumerate(deps_info.packages)
                ]),
            )
