      },
      "sepgsql": {
        "exclude": "SELinux shell harness; impractical in the hermetic sandbox"
      },
      "babelfishpg_money": {
        "exclude": "tests live in the separate babelfish_extensions repo (contrib/babelfishpg_money/test/), merged into contrib/ only inside the build action; not present in @babelfish//<v>/src:dir, so out of single-source-tree harness scope"
      },
      "babelfishpg_tsql": {
        "exclude": "tests live in babelfish_extensions (contrib/babelfishpg_tsql), build-action-merged only; also needs shared_preload_libraries='babelfishpg_tds, pg_stat_statements' + a Babelfish-initialized cluster"
      }
    },
    "test": {
      "*": {
        "babelfishpg_money": {
          "kind": "regress",
          "tests": ["aggregate", "cast", "comparison", "overflow", "index"]
        }
