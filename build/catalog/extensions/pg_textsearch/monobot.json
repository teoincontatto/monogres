{
  "version": 1,
  "name": "pg_textsearch",
  "url": "https://github.com/timescale/pg_textsearch",
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "timescale",
      "name": "pg_textsearch",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/{gh_org}/{name}/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": ["1.4.0"]
  },
  "metadata": {
    "compatible_with": {
      "postgres": {
        "1.4.0": ">=17"
      }
    },
    "test_ext": {
      "smoke": {
        "extensions": ["pg_textsearch"],
        "preload": ["pg_textsearch"]
      },
      "test_overrides": {
        "regress": {
          "preload": ["pg_textsearch"],
          "exclude_tests": ["bmw", "explicit_index", "vector_v1_rejected"]
        }
      }
    }
  }
}
