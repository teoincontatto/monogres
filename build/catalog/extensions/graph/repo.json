{
  "version": 1,
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "Evokoa",
      "name": "pgGraph",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}/graph",
      "url": "https://github.com/{gh_org}/{name}/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "1.2.1": {
      "sha256": "66a25cd06f2ee86b1516a28937bb64288db5dca31aa4a15715a21f9006d1aa47"
    }
  },
  "metadata": {
    "build_system": "pgrx",
    "compatible_with": {
      "postgres": {
        "1.2.1": ">=16"
      }
    },
    "test_ext": {
      "smoke": {
        "extensions": ["graph"]
      },
      "test": {
        "*": {
          "regress": {
            "kind": "regress",
            "inputdir": "tests/pg_regress",
            "tests": ["setup"]
          }
        }
      }
    }
  }
}
