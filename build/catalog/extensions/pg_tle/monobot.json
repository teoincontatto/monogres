{
  "version": 1,
  "name": "pg_tle",
  "url": "https://github.com/aws/pg_tle",
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "aws",
      "name": "pg_tle",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/{gh_org}/{name}/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": ["1.5.3"]
  },
  "control": {
    "1.5.3": {
      "pg_tle": {
        "default_version": "1.5.3",
        "module_pathname": "$libdir/pg_tle",
        "schema": "pgtle"
      }
    }
  },
  "metadata": {
    "compatible_with": {
      "postgres": {
        "1.5.3": ">=16"
      }
    },
    "test_ext": {
      "smoke": {
        "preload": ["pg_tle"]
      }
    }
  }
}
