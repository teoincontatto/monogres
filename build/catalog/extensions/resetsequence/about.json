      "functions",
      "utility",
      "maintenance",
      "administration",
      "resetsequence"
    ],
    "repository": {
      "url": "https://pgxn.org/dist/resetsequence"
    },
    "control": {
      "resetsequence": {
        "default_version": "1.0.0",
