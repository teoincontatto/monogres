{
  "version": 1,
  "name": "bedquilt",
  "url": "https://github.com/BedquiltDB/bedquilt-core",
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "BedquiltDB",
      "name": "bedquilt-core",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/{gh_org}/{name}/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": ["2.1.0"]
  },
  "metadata": {
    "compatible_with": {
      "postgres": {
        "2.1.0": ">=16"
      }
    },
    "test_ext": {
      "requires": ["pgcrypto", "plpython3u"],
      "smoke": {
        "extensions": ["bedquilt"],
        "cascade": true
      }
    }
  }
}
