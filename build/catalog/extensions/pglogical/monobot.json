{
  "version": 1,
  "name": "pglogical",
  "url": "https://github.com/2ndQuadrant/pglogical",
  "sources": {
    "gh": {
      "gh_org": "2ndQuadrant",
      "name": "pglogical",
      "filename": "{tag}",
      "strip_prefix": "{name}-{tag}",
      "url": "https://github.com/{gh_org}/{name}/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": {
      "2.4.8": {
        "tag": "REL2_4_8"
      }
    }
  },
  "metadata": {
    "compatible_with": {
      "postgres": {
        "2.4.8": ">=16"
      }
    },
    "test_ext": {
      "smoke": {
        "extensions": ["pglogical"],
        "preload": ["pglogical"]
      },
      "test_overrides": {
        "regress": {
          "exclude": true
        },
        "tap": {
          "exclude": true
        }
      }
    }
  }
}
