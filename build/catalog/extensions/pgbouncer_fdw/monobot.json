{
  "version": 1,
  "name": "pgbouncer_fdw",
  "url": "https://github.com/CrunchyData/pgbouncer_fdw",
  "sources": {
    "gh": {
      "tag": "v{version}",
      "gh_org": "CrunchyData",
      "name": "pgbouncer_fdw",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/{gh_org}/{name}/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": ["1.4.0"]
  },
  "metadata": {
    "compatible_with": {
      "postgres": {
        "1.4.0": ">=16"
      }
    },
    "test_ext": {
      "requires": ["dblink"],
      "smoke": {
        "extensions": ["pgbouncer_fdw"],
        "cascade": true
      }
    }
  }
}
