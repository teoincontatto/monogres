{
  "version": 1,
  "name": "timescaledb",
  "url": "https://github.com/timescale/timescaledb",
  "sources": {
    "gh": {
      "tag": "{version}",
      "gh_org": "timescale",
      "name": "timescaledb",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/timescale/timescaledb/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "pin": ["2.32.0"]
  },
  "about": {
    "latest": {
      "license": "Apache-2.0 AND LicenseRef-Timescale"
    }
  },
  "control": {
    "2.32.0": {
      "timescaledb": {
        "default_version": "2.32.0",
        "module_pathname": "$libdir/timescaledb-2.32.0"
      }
    }
  },
  "metadata": {
    "build_system": "cmake",
    "build_args": ["-DPG_CONFIG={pg_config}", "-DREGRESS_CHECKS=OFF"],
    "compatible_with": {
      "postgres": {
        "2.32.0": ">=16"
      }
    },
    "test_ext": {
      "smoke": {
        "extensions": ["timescaledb"],
        "preload": ["timescaledb"]
      }
    }
  }
}
