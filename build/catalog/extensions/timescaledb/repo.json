{
  "version": 1,
  "sources": {
    "gh": {
      "tag": "{version}",
      "gh_org": "timescale",
      "name": "timescaledb",
      "filename": "{tag}",
      "strip_prefix": "{name}-{version}",
      "url": "https://github.com/timescale/timescaledb/archive/refs/tags/{filename}.tar.gz"
    }
  },
  "versions": {
    "2.32.0": {
      "sha256": "881b07882719b53b1fe08753a514c5717baaf9644698fd12d58f63a6a86f4ba0"
    }
  },
  "metadata": {
    "build_system": "cmake",
    "build_args": ["-DPG_CONFIG={pg_config}", "-DREGRESS_CHECKS=OFF"],
    "compatible_with": {
      "postgres": {
        "2.32.0": ">=16"
      }
    },
    "test_ext": {
      "smoke": {
        "extensions": ["timescaledb"],
        "preload": ["timescaledb"]
      }
    }
  }
}
