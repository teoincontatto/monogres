load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":cfg.bzl", "CFG")
load(":pg_build.bzl", "pg_build_all")
load(":regress_build.bzl", "regress_build_all")

package(default_visibility = ["//visibility:public"])

exports_files([
    "version.bzl",
    "build_options.bzl",
    "cfg.bzl",
    "pg_build.bzl",
    "regress_build.bzl",
    "sysroot.bzl",
    "toolchain.bzl",
])

bzl_library(
    name = "version",
    srcs = ["version.bzl"],
    deps = [
        "@version_utils//spec",
        "@version_utils//version",
    ],
)

bzl_library(
    name = "build_options",
    srcs = ["build_options.bzl"],
    deps = [
        ":version",
    ],
)

bzl_library(
    name = "cfg",
    srcs = ["cfg.bzl"],
    deps = [
        ":build_options",
        "@pg_src//:repo",
    ],
)

bzl_library(
    name = "sysroot",
    srcs = ["sysroot.bzl"],
)

bzl_library(
    name = "pg_build",
    srcs = ["pg_build.bzl"],
    deps = [
        ":sysroot",
        ":toolchain",
        "@protobuf//bazel:cc_proto_library_bzl",
        "@rules_foreign_cc//foreign_cc:meson",
    ],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = [
        "//toolchains:template_vars",
    ],
)

bzl_library(
    name = "regress_build",
    srcs = ["regress_build.bzl"],
    deps = [
        ":build_options",
    ],
)

pg_build_all(
    name = CFG.name,
    cfg = CFG,
)

regress_build_all(
    name = "regress",
    cfg = CFG,
)
