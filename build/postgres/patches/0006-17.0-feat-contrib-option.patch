diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -3144,7 +3144,16 @@
 
 subdir('src')
 
-subdir('contrib')
+# contrib_data_dir is defined in contrib/meson.build, provide a fallback
+# when contrib is disabled so that install-test-files target still works
+if get_option('contrib')
+  subdir('contrib')
+else
+  contrib_data_dir = dir_data_extension
+  # refint_cflags is used by src/test/regress/meson.build for building
+  # test modules from contrib/spi even when contrib is disabled
+  refint_cflags = ['-DREFINT_VERBOSE']
+endif
 
 subdir('src/test')
 subdir('src/interfaces/libpq/test')
@@ -3587,6 +3596,8 @@
 alias_target('bin', bin_targets + [libpq_st])
 alias_target('pl', pl_targets)
-alias_target('contrib', contrib_targets)
+if get_option('contrib')
+  alias_target('contrib', contrib_targets)
+endif
 alias_target('testprep', testprep_targets)
 
 alias_target('world', all_built, docs)
diff --git a/meson_options.txt b/meson_options.txt
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -79,6 +79,9 @@
